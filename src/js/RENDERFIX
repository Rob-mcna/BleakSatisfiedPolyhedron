function getMostRecentTestedWellId() {
  let mostRecentWellId = null;
  let mostRecentTime = 0;

  if (window.valveTestResults) {
    for (const [wellKey, valves] of Object.entries(window.valveTestResults)) {
      const well = getWellByIdSafe(wellKey);
      if (!well) continue; // skip name aliases, keep canonical ids only

      for (const tests of Object.values(valves)) {
        if (Array.isArray(tests)) {
          for (const test of tests) {
            const ts = test?.utc_timestamp || test?.inputs?.timestamp;
            if (!ts) continue;

            const t = new Date(ts).getTime();
            if (t > mostRecentTime) {
              mostRecentTime = t;
              mostRecentWellId = well.id;
            }
          }
        }
      }
    }
  }

  return mostRecentWellId;
}


