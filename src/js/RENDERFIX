async function loadValveTestStatuses(wellId) {
  console.log(`Loading valve test results for well ${wellId}`);
  try {
    const wellConfig = getWellByIdSafe(wellId);
    if (!wellConfig) {
      console.error(`Could not find well with ID ${wellId}`);
      return {};
    }

    console.log(`Fetching test results from API for well ${wellId}`);
    const response = await fetch(`http://127.0.0.1:5000/api/integrity_test/results?well=${encodeURIComponent(wellId)}`);
    if (!response.ok) {
      console.warn(`Failed to fetch valve test results for well ${wellId}: ${response.statusText}`);
      return {};
    }

    const rows = await response.json();
    console.log(`Fetched test results for well ${wellId}:`, rows);

    const validatedResults = groupIntegrityResultsByValveForRender(rows);

    if (!window.valveTestResults) window.valveTestResults = {};
    if (!window.selectedValveTestIndex) window.selectedValveTestIndex = {};

    // canonical storage by well id
    window.valveTestResults[wellId] = validatedResults;

    // compatibility alias for any old code still reading by well name
    if (wellConfig.name) {
      window.valveTestResults[wellConfig.name] = validatedResults;
    }

    window.selectedValveTestIndex[wellId] = {};
    if (wellConfig.name) {
      window.selectedValveTestIndex[wellConfig.name] = {};
    }

    Object.keys(validatedResults).forEach(valveId => {
      const lastIdx = validatedResults[valveId].length - 1;
      window.selectedValveTestIndex[wellId][valveId] = lastIdx;
      if (wellConfig.name) {
        window.selectedValveTestIndex[wellConfig.name][valveId] = lastIdx;
      }
    });

    console.log(`Successfully loaded and validated test results for well ${wellId}`, validatedResults);
    return validatedResults;
  } catch (error) {
    console.error(`Error loading valve test statuses for well ${wellId}:`, error);
    return {};
  }
}


